# WhatsApp Site Bot Configuration
# Copy this file to .env and fill in the values

# Group name where the bot operates (case-insensitive match, used as fallback)
SITE_GROUP_NAME=Your Site Group Name

# Group invite link (preferred - locks onto the exact group even if renamed)
SITE_GROUP_INVITE=https://chat.whatsapp.com/XXXXXXXXXXXXXXXXXXXXXX

# Admin phone numbers (comma separated, with country code, no + or spaces)
# These users can run admin-only commands (.deleteprogress, .deletematerial)
ADMIN_NUMBERS=60123456789,60198765432

# Date format (dayjs compatible)
DATE_FORMAT=DD/MM/YYYY

# Time format
TIME_FORMAT=HH:mm

# Supabase (records + photos). Setup: README -> Data Storage.
# Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Project Settings -> API -> service_role key (secret - never share or commit)
SUPABASE_SERVICE_KEY=eyJ...
# Connect -> Session pooler connection string, with your DB password filled in
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
